{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "server/Dockerfile.applier",
    "watchPatterns": ["server/**", "shared/**", "extension/src/**", "package-lock.json"]
  },
  "deploy": {
    "startCommand": "node dist/applier.js",
    "restartPolicyType": "ALWAYS"
  }
}
