# Copy to .env for local development. On Railway the api and worker services take everything here; the applier
# (sd1-applier) takes only the variables in the "Applier" block at the end and refuses to boot in production when
# an auth, Stripe, Anthropic, Postmark or webhook secret is set on it (lib/env.ts APPLIER_FORBIDDEN).
NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# Railway Postgres and Redis (local values match docker-compose.yml)
DATABASE_URL=postgres://auto_career:auto_career@localhost:5432/auto_career
REDIS_URL=redis://localhost:6379

# Better Auth. BETTER_AUTH_URL is the web origin, because the browser reaches the API through the web app's /api rewrite.
# In production both must be the same bare https origin (the Vercel production domain, no path) or the api refuses to boot.
BETTER_AUTH_SECRET=replace-with-32+-random-characters
BETTER_AUTH_URL=http://localhost:3000
WEB_ORIGIN=http://localhost:3000
# Comma-separated user ids that may always use the cloud applier, on any plan. Empty: nobody (fails closed).
OWNER_USER_IDS=
# 1 opens the cloud applier to Pro and Max. Keep 0 until WP-04 passes on staging and S-AP4 is settled.
CLOUD_APPLIER_OPEN=0
# Extra exact web origins allowed to sign in (comma list, no wildcards, https only in production), e.g. a Vercel preview alias
CSRF_ALLOWED_ORIGINS=
# chrome-extension://<extension id>, once the extension is loaded
EXTENSION_ORIGIN=
# api only, required in production: 32+ random characters, the same value as KAIROS_EDGE_SECRET on Vercel (web/proxy.ts).
# Only requests carrying it may name their client IP; everything else is keyed on the address Railway's edge saw.
KAIROS_EDGE_SECRET=
# api only: proxies between Railway's edge and the api. Leave 0 unless the S-B1 header probe shows another hop.
TRUSTED_PROXY_HOPS_DIRECT=0
# Google sign-in is offered only when both are set. Redirect URI in the Google console: <WEB_ORIGIN>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Email (Postmark: outbound OTP/reset emails and inbound reply tracking)
POSTMARK_SERVER_TOKEN=
EMAIL_FROM="Kairos <hello@kairos.app>"
INBOUND_EMAIL_DOMAIN=replies.kairos.app
INBOUND_WEBHOOK_SECRET=replace-with-random-secret
# Postmark's inbound webhook, /api/webhooks/postmark/inbound/<path secret>, with Basic credentials in its URL (owner-actions/WP-24.md).
# Unset: that route answers as if it did not exist. The _PREVIOUS values pass too while rotating.
POSTMARK_INBOUND_PATH_SECRET=
POSTMARK_INBOUND_PATH_SECRET_PREVIOUS=
POSTMARK_INBOUND_BASIC_USER=
POSTMARK_INBOUND_BASIC_PASSWORD=
POSTMARK_INBOUND_BASIC_PASSWORD_PREVIOUS=
# Also store reply bodies in clear for the previous release; 0 one release later (owner-actions/WP-24.md).
INBOUND_PLAINTEXT_DUAL_WRITE=1
# Dev and test only: write outgoing mail (sign-up codes) to this JSON-lines file instead of sending it. Refused in production.
MAIL_SINK_FILE=

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# The old signing secret while rolling STRIPE_WEBHOOK_SECRET; empty otherwise.
STRIPE_WEBHOOK_SECRET_PREVIOUS=
# Comma-separated coupon ids whose $0 invoices still grant credits. Empty: a $0 invoice grants nothing.
STRIPE_GRANT_COUPONS=
# JSON map of "<plan>:<interval>" to Stripe price id, e.g. {"starter:month":"price_123","pro:week":"price_456"}
STRIPE_PRICES={}
# 1: Checkout adds Stripe Tax, a required billing address and tax id collection (decision 7). Leave 0 until Stripe Tax
# is activated on the account, or every checkout fails (owner-actions/WP-47.md).
STRIPE_AUTOMATIC_TAX=0

# LLM: Anthropic API (model per agent in docs/superpowers/specs/2026-10-15-kairos-backend-design/_research/anthropic-models.md)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL_FAST=claude-haiku-5-5
ANTHROPIC_MODEL_SMART=claude-sonnet-5-5
# Agent gateway (03-agent-runtime 16.1). legacy keeps the old client above until the S-A1 smoke (npm run llm:smoke)
# passes; anthropic routes every call through the gateway: per-user and global budgets, the llm_calls ledger.
LLM_GATEWAY=legacy
# Per-workspace keys, read only by the gateway (no fallback to ANTHROPIC_API_KEY). The batch key goes on the worker only.
ANTHROPIC_KEY_INTERACTIVE=
ANTHROPIC_KEY_BATCH=
# 32 random bytes, base64 (openssl rand -base64 32): keys llm_calls.user_hash and the stable fence nonce.
# Required in production (it also keys the erasure hashes and tombstones of WP-25: never rotate it).
USER_HASH_KEY=
# Data encryption keys (lib/crypto.ts, docs/runbook/keys.md): comma list of v<n>:<32 random bytes, base64>; the first encrypts.
# Generate: echo "v1:$(openssl rand -base64 32)". api and worker only, never the applier. A malformed value refuses the boot.
DATA_KEKS=
# AI spend controls (WP-06): manual shed level 0-3 (03-agent-runtime 9.5) and the scoring loop's kill switch.
LLM_SHED_LEVEL=0
PAUSE_SCORING=false
# A ceiling on every plan's dailyScoringCap until the per-plan caps are pinned (owner-actions/WP-23.md).
MATCHING_DAILY_CAP_MAX=140

# Object storage: Cloudflare R2 (WP-14, owner-actions/WP-14.md). One token per bucket and service; leave a bucket's
# three variables empty to turn it off (calls then answer 503 storage_unavailable). Never on the applier.
# https://<account id>.r2.cloudflarestorage.com, or a local MinIO such as http://localhost:9000
R2_ENDPOINT=
R2_BUCKET_UPLOADS=
R2_UPLOADS_ACCESS_KEY_ID=
R2_UPLOADS_SECRET_ACCESS_KEY=
R2_BUCKET_RENDERS=
R2_RENDERS_ACCESS_KEY_ID=
R2_RENDERS_SECRET_ACCESS_KEY=
R2_BUCKET_SNAPSHOTS=
R2_SNAPSHOTS_ACCESS_KEY_ID=
R2_SNAPSHOTS_SECRET_ACCESS_KEY=
# Worker only.
R2_BUCKET_BACKUPS=
R2_BACKUPS_ACCESS_KEY_ID=
R2_BACKUPS_SECRET_ACCESS_KEY=
# api and worker (WP-25): one opaque tombstone per erased user, kept forever and replayed after a restore.
R2_BUCKET_TOMBSTONES=
R2_TOMBSTONES_ACCESS_KEY_ID=
R2_TOMBSTONES_SECRET_ACCESS_KEY=

# Privacy (WP-25, owner-actions/WP-25.md): the notice version a sign-up agrees to, and retention overrides in days
# (rule=days, comma-separated; rules in src/jobs/retention.ts). Empty keeps the spec's defaults.
PRIVACY_NOTICE_VERSION=2026-10-30
RETENTION_DAYS=

# Applier: the whole env of sd1-applier. DATABASE_URL there connects as kairos_applier (ops/provision-roles.sql).
# NODE_ENV, LOG_LEVEL, DATABASE_URL, REDIS_URL, OWNER_USER_IDS and CLOUD_APPLIER_OPEN as above, plus:
# Chromium path; empty uses the Playwright image's own browser
CHROMIUM_EXECUTABLE_PATH=
APPLIER_CONCURRENCY=2
FILLER_SCRIPT_PATH=../extension/dist/filler.js
# Chromium's own sandbox. 0 only after the owner signs the S-AP4 risk acceptance.
APPLIER_CHROMIUM_SANDBOX=1
