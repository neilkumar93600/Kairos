# Copy to .env for local development. On Railway, set these on the api, worker and applier services.
NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# Railway Postgres and Redis (local values match docker-compose.yml)
DATABASE_URL=postgres://auto_career:auto_career@localhost:5432/auto_career
REDIS_URL=redis://localhost:6379

# Better Auth. BETTER_AUTH_URL is the web origin, because the browser reaches the API through the web app's /api rewrite.
# In production both must be the same bare https origin (the Vercel production domain, no path) or the api refuses to boot.
BETTER_AUTH_SECRET=replace-with-32+-random-characters
BETTER_AUTH_URL=http://localhost:3000
WEB_ORIGIN=http://localhost:3000
# Comma-separated user ids allowed to use the cloud applier until it is contained. Empty: nobody (fails closed).
OWNER_USER_IDS=
# Extra exact web origins allowed to sign in (comma list, no wildcards, https only in production), e.g. a Vercel preview alias
CSRF_ALLOWED_ORIGINS=
# chrome-extension://<extension id>, once the extension is loaded
EXTENSION_ORIGIN=
# Google sign-in is offered only when both are set. Redirect URI in the Google console: <WEB_ORIGIN>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Email (Postmark: outbound OTP/reset emails and inbound reply tracking)
POSTMARK_SERVER_TOKEN=
EMAIL_FROM="Kairos <hello@kairos.app>"
INBOUND_EMAIL_DOMAIN=replies.kairos.app
INBOUND_WEBHOOK_SECRET=replace-with-random-secret
# Dev and test only: write outgoing mail (sign-up codes) to this JSON-lines file instead of sending it. Refused in production.
MAIL_SINK_FILE=

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# JSON map of "<plan>:<interval>" to Stripe price id, e.g. {"starter:month":"price_123","pro:week":"price_456"}
STRIPE_PRICES={}

# LLM: Anthropic API (model per agent in docs/superpowers/specs/2026-10-15-kairos-backend-design/_research/anthropic-models.md)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL_FAST=claude-haiku-5-5
ANTHROPIC_MODEL_SMART=claude-sonnet-5-5
# Agent gateway (03-agent-runtime 16.1). legacy keeps the old client above until the S-A1 smoke (npm run llm:smoke)
# passes; anthropic routes every call through the gateway: per-user and global budgets, the llm_calls ledger.
LLM_GATEWAY=legacy
# Per-workspace keys, read only by the gateway (no fallback to ANTHROPIC_API_KEY). The batch key goes on the worker only.
ANTHROPIC_KEY_INTERACTIVE=
ANTHROPIC_KEY_BATCH=
# 32 random bytes, base64 (openssl rand -base64 32): keys llm_calls.user_hash and the stable fence nonce.
# Required in production with LLM_GATEWAY=anthropic.
USER_HASH_KEY=
# AI spend controls (WP-06): manual shed level 0-3 (03-agent-runtime 9.5) and the scoring loop's kill switch.
LLM_SHED_LEVEL=0
PAUSE_SCORING=false

# Applier only: Chromium path inside the Playwright image
CHROMIUM_EXECUTABLE_PATH=
APPLIER_CONCURRENCY=2
FILLER_SCRIPT_PATH=../extension/dist/filler.js
