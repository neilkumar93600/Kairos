# Copy to .env for local development. On Railway, set these on the api, worker and applier services.
NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# Railway Postgres and Redis (local values match docker-compose.yml)
DATABASE_URL=postgres://auto_career:auto_career@localhost:5432/auto_career
REDIS_URL=redis://localhost:6379

# Better Auth. BETTER_AUTH_URL is the web origin, because the browser reaches the API through the web app's /api rewrite.
BETTER_AUTH_SECRET=replace-with-32+-random-characters
BETTER_AUTH_URL=http://localhost:3000
WEB_ORIGIN=http://localhost:3000
# chrome-extension://<extension id>, once the extension is loaded
EXTENSION_ORIGIN=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Email (Postmark: outbound OTP/reset emails and inbound reply tracking)
POSTMARK_SERVER_TOKEN=
EMAIL_FROM="Kairos <hello@kairos.app>"
INBOUND_EMAIL_DOMAIN=replies.kairos.app
INBOUND_WEBHOOK_SECRET=replace-with-random-secret

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# JSON map of "<plan>:<interval>" to Stripe price id, e.g. {"starter:month":"price_123","pro:week":"price_456"}
STRIPE_PRICES={}

# LLM (any OpenAI-compatible chat completions endpoint)
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL_FAST=replace-with-a-small-cheap-model
LLM_MODEL_SMART=replace-with-a-stronger-model

# Applier only: Chromium path inside the Playwright image
CHROMIUM_EXECUTABLE_PATH=
APPLIER_CONCURRENCY=2
FILLER_SCRIPT_PATH=../extension/dist/filler.js
