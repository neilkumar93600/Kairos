{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "ops/pgbackup/Dockerfile",
    "watchPatterns": ["ops/pgbackup/**", "server/src/pgbackup.ts", "server/src/lib/**", "package-lock.json"]
  },
  "deploy": {
    "startCommand": "node dist/pgbackup.js auto",
    "cronSchedule": "10 2 * * *",
    "restartPolicyType": "NEVER"
  }
}
